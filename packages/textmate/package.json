  "scripts": {
    "build": "pnpm clean && tsc && node ./scripts/build.ts",
    "test": "node --test",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@shikijs/types": "^4.4.2",
    "@mirascript/constants": "workspace:~"
  },
  "devDependencies": {
    "@shikijs/core": "^4.4.2",
    "@shikijs/engine-oniguruma": "^4.4.2",
    "@shikijs/vscode-textmate": "^10.0.2"
  }
