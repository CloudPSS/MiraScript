{
  "name": "@mirascript/textmate",
  "version": "0.1.82",
  "author": "CloudPSS",
  "license": "MIT",
  "description": "TextMate grammars for MiraScript.",
  "keywords": [
    "mirascript",
    "textmate",
    "shiki",
    "syntax-highlighting"
  ],
  "homepage": "https://mira.cloudpss.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CloudPSS/MiraScript.git",
    "directory": "packages/textmate"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
