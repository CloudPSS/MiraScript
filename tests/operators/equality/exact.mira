t_true(nil == nil);
t_false(nil != nil);

t_true(true == true);
t_true(false == false);
t_false(true == false);

t_true(1 == 1);
t_true(1.0 == 1);
t_false(0.1 + 0.2 == 0.3);
t_false(1 == 2);
t_false(nan == nan);
t_true(inf == inf);
t_true(-inf == -inf);
t_true(+0 == -0);
t_true(1 != nan);
t_true(nan != nan);

t_true('abc' == 'abc');
t_false('abc' == 'ABC');
t_false('e' == 'é');
t_false('abc' == 'ab');
t_false('é' == 'é');

// Exact equality never coerces operands.
t_false(1 == '1');
t_false(0 == false);
t_false(0 == nil);
t_false(0 == "0");
t_false(false == "");
t_false(false == nil);

t_false((a: 1, b: 2) == (a: 1));
t_false((b: 1) == (a: 1));
t_false((a: 1, b: '2') == (a: 1, b: 2));
t_true((1, 2, 3) == (1, 2, 3));
t_true([1, 2, 3, nil, "xx", ("a", [true])] == [1, 2, 3, nil, "xx", ("a", [true])]);
t_true([1, 2, 3] != (1, 2, 3));
t_false([0] == [false]);
t_false([0] == [nil]);
t_false([0] == ["0"]);
t_false([false] == [""]);
t_false([false] == [nil]);
t_false([1, 2] == (1, 2));
t_false((1, 2, 3) == (1, 2, 4));
t_false([1, 2, 3] == [1, 2, 4]);
t_true((nan,) == (nan,));
t_true((x: nan) == (x: -nan));
t_false([nil] == []);
t_false((nil, nil) == (a: nil, b: nil));
t_false((a: nil) == ());
t_true((a?: nil) == ());
t_true((1, 2) == (1: 2, 0: 1));
t_true((1, 2) == ("1": 2, "0": 1));

t_false(v_fn == v_fn_another);
t_true(v_fn == v_fn);
t_false(v_fn == nil);
t_false(nil == v_fn);
t_false(v_fn == ());
t_false(() == v_fn);

if has_extern {
  t_false(v_extern == v_extern_another);
  t_true(v_extern == v_extern);
  t_false(v_extern == nil);
  t_false(nil == v_extern);
  t_false(v_extern == ());
  t_false(() == v_extern);
}

t_false(v_module == v_module_another);
t_true(v_module == v_module);
t_false(v_module == nil);
t_false(nil == v_module);
t_false(v_module == ());
t_false(() == v_module);

if has_extern {
  t_false(v_extern == v_module);
  t_true(v_module != v_extern);
}