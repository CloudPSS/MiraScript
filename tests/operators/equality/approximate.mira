t_throws(fn { ({ nil } =~ { nil }) });
t_throws(fn { ({ nil } !~ { nil }) });

t_true({ true } =~ { true });
t_false({ false } =~ { true });

t_true(1 =~ 1);
t_true(1.0 =~ 1);
t_true(0.1 + 0.2 =~ 0.3);
t_false(1 =~ 2);
t_false(nan =~ nan);
t_true(inf =~ inf);
t_true(-inf =~ -inf);
t_true(+0 =~ -0);
t_true(1 !~ nan);
t_true(nan !~ nan);

t_true('abc' =~ 'abc');
t_true('abc' =~ 'ABC');
t_false('e' =~ 'é');
t_false('abc' =~ 'ab');
t_true('é' =~ 'é'); // Unicode normalization

// Approximate equality converts to numbers when possible and strings otherwise.
t_true(1 =~ '1');
t_true(1 =~ '1.0');
t_true('1' =~ 1);
t_true('1.0' =~ 1);
t_true({ true } =~ 'true');
t_true('true' =~ { true });
t_false('1' =~ { true });
t_true(1 =~ { true });
t_true({ true } =~ 1);
t_true(0 =~ { false });
t_true({ false } =~ 0);
t_true('' =~ { nil });
t_true({ nil } =~ '');
t_false('' =~ '0');
t_true(fn { } =~ '<function>');

t_throws(fn { (fn { } !~ fn { }) });
t_throws(fn { (1, 2, 3) =~ (1, 2, 3) });
t_throws(fn { [1, 2, 3] =~ [1, 2, 3] });
t_throws(fn { v_module =~ v_module_another });
if has_extern {
  t_throws(fn { v_extern =~ v_extern_another });
  t_throws(fn { v_module =~ v_extern });
}
