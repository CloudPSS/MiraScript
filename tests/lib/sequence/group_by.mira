t_throws(fn { group_by() });
t_throws(fn { group_by(nil, fn { }) });
t_throws(fn { group_by((), fn { }) });
t_throws(fn { group_by(1, fn { }) });
t_throws(fn { group_by("1", fn { }) });
t_throws(fn { group_by([]) });
t_throws(fn { group_by([], ()) });
t_eq(group_by([], fn { }), ());

t_eq(group_by([1, 2, 3, 4], fn { it % 2 }), ([2, 4], [1, 3]));
t_eq(group_by([(id: 'x', data: 12), (id: 'y', data: 34)], fn { it.id }), ("x": [(id: 'x', data: 12)], "y": [(id: 'y', data: 34)]));
t_eq(group_by(chars("Hello"), fn (_, k) { k }), (["H"], ["e"], ["l"], ["l"], ["o"]));
t_eq(group_by([1, 2, 3], fn { "__proto__" }), (__proto__: [1, 2, 3]));
t_eq(group_by([1, 2, 3], fn { "constructor" }), (constructor: [1, 2, 3]));
