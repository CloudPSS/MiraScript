fn near(actual, expected) {
  t_eq(type(actual), 'record');
  t_eq(len(keys(actual)), 2);
  for i in [0, 1] {
    t_true(
      abs(actual[i] - expected[i]) <= 1e-12 * max(1, abs(expected[i])),
      `$actual != $expected`,
    );
  }
}
// Independent reference values at 1+2i.
for (name, expected) in [
  ('exp', (-1.131_204_383_756_813_5, 2.471_726_672_004_818_8)),
  ('expm1', (-2.131_204_383_756_813_5, 2.471_726_672_004_818_8)),
  ('log', (0.804_718_956_217_050_3, 1.107_148_717_794_090_4)),
  ('log1p', (1.039_720_770_839_918, 0.785_398_163_397_448_3)),
  ('log2', (1.160_964_047_443_681_3, 1.597_277_964_688_108_8)),
  ('log10', (0.349_485_002_168_009_4, 0.480_828_578_784_234)),
  ('sin', (3.165_778_513_216_168, 1.959_601_041_421_606_3)),
  ('cos', (2.032_723_007_019_665_6, -3.051_897_799_151_8)),
  ('tan', (0.033_812_826_079_896_7, 1.014_793_616_146_633_5)),
  ('sinh', (-0.489_056_259_041_293_7, 1.403_119_250_622_040_5)),
  ('cosh', (-0.642_148_124_715_52, 1.068_607_421_382_778_3)),
  ('tanh', (1.166_736_257_240_92, -0.243_458_201_185_725_34)),
  ('asin', (0.427_078_586_392_476_1, 1.528_570_919_480_998_2)),
  ('acos', (1.143_717_740_402_420_4, -1.528_570_919_480_998_2)),
  ('atan', (1.338_972_522_294_493_5, 0.402_359_478_108_525_07)),
  ('asinh', (1.469_351_744_368_185_2, 1.063_440_023_577_752)),
  ('acosh', (1.528_570_919_480_998_2, 1.143_717_740_402_420_4)),
  ('atanh', (0.173_286_795_139_986_32, 1.178_097_245_096_172_4)),
] {
  near(complex[name]((1, 2)), expected);
}
near(complex.exp((0, PI)), (-1, 0));
near(complex.log(-1), (0, PI));
near(complex.log2(8), (3, 0));
near(complex.log10(100), (2, 0));
for z in [(0.2, 0.3), (-0.4, 0.5), (0.1, -0.7)] {
  near(complex.sin(complex.asin(z)), z);
  near(complex.cos(complex.acos(z)), z);
  near(complex.tan(complex.atan(z)), z);
  near(complex.sinh(complex.asinh(z)), z);
  near(complex.cosh(complex.acosh(z)), z);
  near(complex.tanh(complex.atanh(z)), z);
}
for name in ['expm1', 'log1p'] {
  let f = complex[name];
  let z = f((1e-20, 1e-20));
  t_true(abs(z[0] / 1e-20 - 1) < 1e-12);
  t_true(abs(z[1] / 1e-20 - 1) < 1e-12);
}
