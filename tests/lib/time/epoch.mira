let epoch = 0;
let expected = (
  year: 1970,
  month: 1,
  day: 1,
  hour: 0,
  minute: 0,
  second: 0,
  millisecond: 0,
  dayOfWeek: 4,
  offset: 0,
);

t_eq(to_timestamp(epoch), 0);
t_eq(to_datetime(epoch), expected);
t_eq(to_iso8601(epoch), '1970-01-01T00:00:00.000Z');

// A fallback is ignored when conversion succeeds.
t_eq(to_timestamp(epoch, 'fallback'), 0);
t_eq(to_datetime(epoch, nil, 'fallback'), expected);
t_eq(to_iso8601(epoch, 'fallback'), '1970-01-01T00:00:00.000Z');
