{
  t_true(() is (a?: x, b?: y));
  t_eq(x, nil);
  t_eq(y, nil);
}
{
  t_true(() is (?:a, ?:b));
  t_eq(a, nil);
  t_eq(b, nil);
}
{
  t_false([] is (?:x));
  t_eq(x, nil);
}
{
  t_false((a: 1) is (a: x, b: y));
  t_eq(x, 1);
  t_eq(y, nil);
}
{
  t_false((a: 1) is (:a, :b));
  t_eq(a, 1);
  t_eq(b, nil);
}
{
  t_true((a: 1) is (a: x, b?: y));
  t_eq(x, 1);
  t_eq(y, nil);
}
{
  t_true((a: 1) is (:a, ?:b));
  t_eq(a, 1);
  t_eq(b, nil);
}
{
  t_true((a: 1, b: nil) is (a: x, b: y));
  t_eq(x, 1);
  t_eq(y, nil);
}
{
  t_true((a: 1, b: nil) is (:a, :b));
  t_eq(a, 1);
  t_eq(b, nil);
}
{
  t_false((a: 1, b: nil) is (a: x, b?: 12));
  t_eq(x, 1);
}
{
  t_false((a: 1, b: nil) is (:a, b?: 12));
  t_eq(a, 1);
}
{
  t_false((a: 1, b: nil) is (a: x, c?: y));
  t_eq(x, 1);
  t_eq(y, nil);
}
{
  t_false((a: 1, b: nil) is (:a, ?:c));
  t_eq(a, 1);
  t_eq(c, nil);
}
{
  t_true((a: 1, b: nil) is (a: x, c?: y, ..));
  t_eq(x, 1);
  t_eq(y, nil);
}
{
  t_true((a: 1, b: nil) is (:a, ?:c, ..));
  t_eq(a, 1);
  t_eq(c, nil);
}
{
  t_true((a: 1, b: nil) is (a: x, c?: y, ..rest));
  t_eq(x, 1);
  t_eq(y, nil);
  t_eq(rest, (b: nil));
}
{
  t_true((a: 1, b: nil) is (:a, ?:c, ..rest));
  t_eq(a, 1);
  t_eq(c, nil);
  t_eq(rest, (b: nil));
}